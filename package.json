{
    "name": "bookbridgers-app",
    "version": "1.0.0",
    "description": "BookBridgers - Library Management System",
    "main": "index.js",
    "scripts": {
        "start": "concurrently \"npm run server\" \"npm run client\"",
        "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
        "server": "cd server && npm start",
        "server:dev": "cd server && npm run dev",
        "client": "cd client && npm start",
        "client:dev": "cd client && npm start",
        "install:all": "npm install && cd server && npm install && cd ../client && npm install",
        "build": "cd client && npm run build",
        "seed": "cd server && node seedSampleData.js",
        "add-images": "cd server && node addBookImages.js",
        "mongodb:start": "brew services start mongodb-community",
        "mongodb:stop": "brew services stop mongodb-community",
        "mongodb:restart": "brew services restart mongodb-community",
        "setup": "npm run install:all && npm run mongodb:start && npm run seed",
        "clean": "cd server && rm -rf node_modules && cd ../client && rm -rf node_modules && rm -rf node_modules"
    },
    "keywords": [
        "library",
        "management",
        "books",
        "react",
        "nodejs",
        "mongodb"
    ],
    "author": "BookBridgers Team",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}